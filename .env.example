# These are set in Vercel → Project → Settings → Environment Variables.
# DATABASE_URL and BLOB_READ_WRITE_TOKEN are added automatically when you connect
# a Neon database and a Blob store from the project's Storage tab.
DATABASE_URL=postgres://...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# The secret part of the family invite link: https://your-site/#/join/<FAMILY_CODE>
FAMILY_CODE=pick-something-long-and-hard-to-guess
